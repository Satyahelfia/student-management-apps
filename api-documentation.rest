### ==========================================
### API Documentation - Student Management App
### ==========================================
### Base URL menggunakan 127.0.0.1 (bukan localhost)
### karena lebih stabil pada macOS (menghindari resolusi IPv6).
###
### Cara pakai:
### 1. Jalankan request "Login" terlebih dahulu
### 2. Copy token dari response
### 3. Ganti nilai @token di bawah dengan token tersebut
### 4. Jalankan request lainnya
### ==========================================

@baseUrl = http://127.0.0.1:9090
@token = your_jwt_token_here

### ==========================================
### 1. AUTHENTICATION
### ==========================================

# Login to get JWT Token
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "username": "admin",
    "password": "admin"
}


### ==========================================
### 2. STUDENTS API
### ==========================================

# Get all students
GET {{baseUrl}}/students/
Authorization: Bearer {{token}}

###

# Get student by ID
GET {{baseUrl}}/students/1
Authorization: Bearer {{token}}

###

# Create a new student
POST {{baseUrl}}/students/
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "John Doe",
    "average": 8.5
}

###

# Update a student
PUT {{baseUrl}}/students/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "John Doe Updated",
    "average": 9.2
}

###

# Delete a student
DELETE {{baseUrl}}/students/1
Authorization: Bearer {{token}}

###

# Get config: max projects per student
GET {{baseUrl}}/students/config/max_projects
Authorization: Bearer {{token}}

###

# Update config: max projects per student
PUT {{baseUrl}}/students/config/max_projects
Content-Type: application/json
Authorization: Bearer {{token}}

5


### ==========================================
### 3. STUDENT - PROJECTS API
### ==========================================

# Get projects assigned to a student
GET {{baseUrl}}/students/1/projects
Authorization: Bearer {{token}}

###

# Assign a project to a student
POST {{baseUrl}}/students/1/projects/2
Authorization: Bearer {{token}}

###

# Remove a project from a student
DELETE {{baseUrl}}/students/1/projects/2
Authorization: Bearer {{token}}

###

# Get available projects for a student (projects they haven't taken yet)
GET {{baseUrl}}/students/1/availableprojects
Authorization: Bearer {{token}}


### ==========================================
### 4. PROJECTS API
### ==========================================

# Get all projects
GET {{baseUrl}}/projects/
Authorization: Bearer {{token}}

###

# Get project by ID
GET {{baseUrl}}/projects/1
Authorization: Bearer {{token}}

###

# Create a new project (JSON Fallback)
POST {{baseUrl}}/projects/
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Web Development 101"
}

###

# Create a new project (With PDF & Image - Multipart form-data)
POST {{baseUrl}}/projects/
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary-string

--boundary-string
Content-Disposition: form-data; name="name"

Advanced AI Systems
--boundary-string
Content-Disposition: form-data; name="pdf"; filename="syllabus.pdf"
Content-Type: application/pdf

< ./syllabus.pdf
--boundary-string
Content-Disposition: form-data; name="image"; filename="cover.png"
Content-Type: image/png

< ./cover.png
--boundary-string--

###

# Get Project PDF file
GET {{baseUrl}}/projects/1/pdf
Authorization: Bearer {{token}}

###

# Get Project Image file
GET {{baseUrl}}/projects/1/image
Authorization: Bearer {{token}}

###

# Update a project
PUT {{baseUrl}}/projects/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Advanced Web Development"
}


###

# Delete a project
DELETE {{baseUrl}}/projects/1
Authorization: Bearer {{token}}


### ==========================================
5. ASSIGNMENT API
### ==========================================

# Auto-assign projects to students based on average score
GET {{baseUrl}}/students/assignment
Authorization: Bearer {{token}}


### ==========================================
### 6. SUBMISSIONS AND GRADING API
### ==========================================

# Get project details with dates, status, grade, and feedback for a student
GET {{baseUrl}}/students/1/projectdetails
Authorization: Bearer {{token}}

###

# Submit a project assignment (Student role)
POST {{baseUrl}}/students/1/projects/1/submit
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "submissionUrl": "https://github.com/student/my-project",
    "submissionText": "Here is my completed task, please review it."
}

###

# Grade a project submission and write feedback (Admin role)
POST {{baseUrl}}/students/1/projects/1/grade
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "grade": 90.0,
    "feedback": "Excellent work! Code is neat and structure is perfect."
}

